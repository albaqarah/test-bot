# ==== [KONEKSI — BOS LLM] ====
BOS_PROVIDER=jev

# JEV = TypeSafe jev-1.13 via OpenRouter Decisions API (utama)
JEV_API_KEY=<key openrouter lu>
JEV_MODEL=typesafe/jev-1.13
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
JEV_TIMEOUT=12


# Telegram notifikasi (entry/exit & briefing)
TG_BOT_TOKEN=<token dari @BotFather>
TG_CHAT_ID=<chat id lu>

# Hanya untuk MODE=live (eksekusi beneran):
BINANCE_API_KEY=
BINANCE_API_SECRET=
MODE=dry

# ==== TUNING BOT (ubah angka -> restart bot) ====
MARGIN_USD=2            # margin per posisi ($)
LEVERAGE=10             # leverage
SL_PCT=0.012            # SL default 1.2% dari entry (bos bisa override via varian eksekusi)
BE_TRIG=0.0010          # (TRAIL=off) shift BE kalau profit >= 0.1%
BE_OFF=0.0006           # (TRAIL=off) BE = entry +/- 0.06%
TRAIL_ACT=0.004       # v12.3.4: balik ke +0.4% — mulai ngunci profit saat mv >= +0.4%
TRAIL_DIST=0.002      # v12.3.1: SL ngunci 0.2% di belakang puncak harga (trailing)
TRAIL=on                # P10b toggle: on = trailing profit lock, off = BE lama
MAXHOLD_TREND=480       # max hold trend (bar 5m)
MAXHOLD_CHOP=96         # max hold chop (bar 5m)
COOLDOWN_MIN=30         # anti re-entry pasca exit (menit)
SCAN_SEC=60             # jeda antar scan idle (detik)
P6_LOOSE=off            # fade longgar (rollback: off)
MIN_CONF=55             # P17: conf minimum utk ACC (p total CONFIRMED*); 0 = off
